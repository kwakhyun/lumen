# Vercel Marketplace provisions these for the production database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google login. Register https://YOUR_DOMAIN/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=
# One-time legacy account mapping; never populate from client input.
AUTH_LEGACY_OWNER_MAP=

# Server-only AI provider secrets. Existing GPT model: gpt-6.1-terra.
# Claude (claude-opus-5-5) collects web-search answers and writes agent results when set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
LUMEN_PROVIDER_MODE=paid_enabled
APP_BASE_URL=

# Preserve existing GA4 ciphertext with the original encryption key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
GOOGLE_OAUTH_MODE=
LUMEN_OPERATOR_USER_ID=
LUMEN_AUTOMATION_SECRET=

# Vercel Schedules: isolated from the manual service credential above.
CRON_SECRET=
# Keep false until production cutover; preview is also blocked by VERCEL_ENV.
LUMEN_SCHEDULES_ENABLED=false
